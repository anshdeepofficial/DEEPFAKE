{
  "manifest_version": 3,
  "name": "DeepGuard Verify",
  "version": "1.0.0",
  "description": "Verify selected claims on the current page with DeepGuard and inspect supporting evidence.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "DeepGuard Verify",
    "default_popup": "popup.html"
  }
}
