[Unit]
Description=DeepGuard – Multimodal Forensic Analysis and Claim Verification
Documentation=https://github.com/anshdeepofficial/DEEPFAKE
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deepguard
Group=deepguard
WorkingDirectory=/opt/deepguard
ExecStart=/opt/deepguard/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=append:/var/log/deepguard/access.log
StandardError=append:/var/log/deepguard/error.log
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/deepguard
Environment=DEEPGUARD_MAX_UPLOAD_MB=50
Environment=DEEPGUARD_RATE_LIMIT_PER_MIN=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/deepguard

[Install]
WantedBy=multi-user.target
